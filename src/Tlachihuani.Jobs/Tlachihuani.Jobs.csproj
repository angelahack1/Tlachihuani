<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- SCM and redirected native control never need a console. This also
         prevents flashes when called from older installed Tlamatini clients. -->
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>../../assets/branding/XT.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Tlachihuani.Windows/Tlachihuani.Windows.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
    <Content Include="../../workers/torrent/*.py" Link="worker/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="wwwroot/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
